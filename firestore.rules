rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "admin";
    }

    function currentMember(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
    }

    function isGlobalAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function ownsGame(groupId) {
      return isGroupMember(groupId)
        && (
          resource.data.owner == currentMember(groupId).username
          || resource.data.ownerNormalized == currentMember(groupId).usernameNormalized
        );
    }

    function ownsPlayGame(groupId) {
      return isGroupMember(groupId)
        && exists(/databases/$(database)/documents/groups/$(groupId)/games/$(resource.data.gameId))
        && (
          get(/databases/$(database)/documents/groups/$(groupId)/games/$(resource.data.gameId)).data.owner == currentMember(groupId).username
          || get(/databases/$(database)/documents/groups/$(groupId)/games/$(resource.data.gameId)).data.ownerNormalized == currentMember(groupId).usernameNormalized
        );
    }

    match /users/{userId} {
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /usernames/{usernameId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(usernameId));
      allow update, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if signedIn();
      allow update, delete: if isGroupAdmin(groupId);

      match /members/{userId} {
        allow read: if isGroupMember(groupId);
        allow create: if signedIn() && request.auth.uid == userId;
        allow update: if isGroupAdmin(groupId) || (signedIn() && request.auth.uid == userId);
        allow delete: if isGroupAdmin(groupId);
      }

      match /games/{gameId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId);
        allow delete: if isGroupAdmin(groupId) || ownsGame(groupId);
      }

      match /plays/{playId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId);
        allow delete: if isGroupAdmin(groupId) || ownsPlayGame(groupId);
      }

      match /playerProfiles/{playerId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId);
        allow delete: if isGroupAdmin(groupId);
      }
    }

    match /gameCatalog/{catalogGameId} {
      allow read: if signedIn();
      allow create, update, delete: if isGlobalAdmin();
    }
  }
}
